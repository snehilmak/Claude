{
  "ConnectionStrings": {
    // SQLite database file — created automatically in the project folder on first run
    "DefaultConnection": "Data Source=mtp.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Session cookie name
  "SessionCookieName": "mtp_session"
}
