@page
@model MtpApp.Pages.Dashboard.Reports.IndexModel
@{
    ViewData["Title"] = "Reports";
    Layout = "_Layout";
}

<div class="d-flex">
    @await Html.PartialAsync("_DashboardLayout")

    <div class="main-content p-4 w-100">
        <h4 class="fw-bold mb-4">Compliance Reports</h4>

        <!-- ── CTR Alert ─────────────────────────────────────────────────── -->
        @if (Model.CtrCustomers.Any())
        {
            <div class="alert alert-warning d-flex align-items-start gap-2 mb-4">
                <i class="bi bi-exclamation-triangle-fill fs-5 mt-1"></i>
                <div>
                    <strong>CTR Filing Required</strong><br/>
                    <span class="small">
                        @Model.CtrCustomers.Count customer(s) exceeded the $1,000 daily threshold today
                        and require a Currency Transaction Report (CTR) filing with FinCEN.
                    </span>
                </div>
            </div>
        }

        <!-- ── Summary stats ─────────────────────────────────────────────── -->
        <div class="row g-3 mb-4">
            <div class="col-sm-4">
                <div class="card border-0 shadow-sm p-3 text-center">
                    <div class="text-muted small mb-1">Transactions This Month</div>
                    <div class="fs-2 fw-bold">@Model.MonthCount</div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="card border-0 shadow-sm p-3 text-center">
                    <div class="text-muted small mb-1">Total Volume This Month</div>
                    <div class="fs-2 fw-bold text-success">@Model.MonthVolume.ToString("C")</div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="card border-0 shadow-sm p-3 text-center">
                    <div class="text-muted small mb-1">CTR-Flagged Customers</div>
                    <div class="fs-2 fw-bold text-warning">@Model.CtrCustomers.Count</div>
                </div>
            </div>
        </div>

        <!-- ── CTR customers table ───────────────────────────────────────── -->
        @if (Model.CtrCustomers.Any())
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-warning bg-opacity-25 fw-semibold">
                    <i class="bi bi-flag-fill text-warning me-2"></i>CTR-Flagged Customers (Today)
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Customer</th>
                                <th>Phone</th>
                                <th>Daily Total</th>
                                <th>CTR Filed?</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.CtrCustomers)
                            {
                                <tr>
                                    <td class="fw-medium">@row.Customer.FullName</td>
                                    <td>@row.Customer.Phone</td>
                                    <td class="fw-bold text-danger">@row.DailyTotal.ToString("C")</td>
                                    <td>
                                        @if (row.Customer.IsCtrReported)
                                        {
                                            <span class="badge bg-success">Filed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Pending</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- ── Monthly breakdown by company ─────────────────────────────── -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">Volume by Company — This Month</div>
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Company</th>
                            <th>Transactions</th>
                            <th>Volume (USD)</th>
                            <th>Fees Collected</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.CompanyBreakdown)
                        {
                            <tr>
                                <td>@row.CompanyName</td>
                                <td>@row.Count</td>
                                <td>@row.Volume.ToString("C")</td>
                                <td>@row.Fees.ToString("C")</td>
                            </tr>
                        }
                        @if (!Model.CompanyBreakdown.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">No data for this month</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
