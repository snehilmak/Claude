@page
@model MtpApp.Pages.Dashboard.Transactions.NewModel
@{
    ViewData["Title"] = "New Transaction";
    Layout = "_Layout";
}

<div class="d-flex">
    @await Html.PartialAsync("_DashboardLayout")

    <div class="main-content p-4 w-100">
        <div class="mb-4">
            <a href="/dashboard/transactions" class="text-muted text-decoration-none small">
                <i class="bi bi-arrow-left me-1"></i>Back to Transactions
            </a>
            <h4 class="fw-bold mt-1 mb-0">New Transaction</h4>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <form method="post" class="row g-4">

            <!-- ── Sender (Customer) ─────────────────────────────────────── -->
            <div class="col-12">
                <div class="card border-0 shadow-sm p-4">
                    <h6 class="fw-semibold mb-3">Sender</h6>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Select Customer <span class="text-danger">*</span></label>
                        <select asp-for="CustomerId" class="form-select" required>
                            <option value="">— Choose a customer —</option>
                            @foreach (var c in Model.Customers)
                            {
                                <option value="@c.Id" disabled="@c.IsBlocked">
                                    @c.FullName (@c.Phone)@(c.IsBlocked ? " [BLOCKED]" : "")
                                </option>
                            }
                        </select>
                    </div>
                    <a href="/dashboard/customers/new" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-person-plus me-1"></i>Add new customer
                    </a>
                </div>
            </div>

            <!-- ── Recipient ─────────────────────────────────────────────── -->
            <div class="col-12">
                <div class="card border-0 shadow-sm p-4">
                    <h6 class="fw-semibold mb-3">Recipient</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Recipient Name <span class="text-danger">*</span></label>
                            <input asp-for="RecipientName" class="form-control" placeholder="Full name" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-medium">Country <span class="text-danger">*</span></label>
                            <select asp-for="RecipientCountry" class="form-select" required>
                                <option value="">Select country</option>
                                <option value="MX">Mexico</option>
                                <option value="GT">Guatemala</option>
                                <option value="HN">Honduras</option>
                                <option value="SV">El Salvador</option>
                                <option value="CO">Colombia</option>
                                <option value="PE">Peru</option>
                                <option value="EC">Ecuador</option>
                                <option value="DO">Dominican Republic</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-medium">Recipient Phone</label>
                            <input asp-for="RecipientPhone" class="form-control" placeholder="+52..." />
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Transfer details ──────────────────────────────────────── -->
            <div class="col-12">
                <div class="card border-0 shadow-sm p-4">
                    <h6 class="fw-semibold mb-3">Transfer Details</h6>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-medium">Transfer Company <span class="text-danger">*</span></label>
                            <select asp-for="CompanyId" class="form-select" required>
                                <option value="">Select company</option>
                                @foreach (var c in Model.Companies)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-medium">Send Amount (USD) <span class="text-danger">*</span></label>
                            <input asp-for="SendAmount" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-medium">Exchange Rate <span class="text-danger">*</span></label>
                            <input asp-for="ExchangeRate" type="number" step="0.0001" min="0" class="form-control" placeholder="0.0000" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-medium">Fee (USD)</label>
                            <input asp-for="Fee" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-medium">Payment Method</label>
                            <select asp-for="PaymentMethod" class="form-select">
                                @foreach (var p in Enum.GetNames<MtpApp.Models.PaymentMethod>())
                                {
                                    <option value="@p">@p</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-medium">Control Number (PIN)</label>
                            <input asp-for="ControlNumber" class="form-control" placeholder="Optional" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-medium">Reference Number</label>
                            <input asp-for="ReferenceNumber" class="form-control" placeholder="Optional" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-medium">Purpose of Transfer</label>
                            <input asp-for="PurposeOfTransfer" class="form-control" placeholder="Family support..." />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-medium">Source of Funds</label>
                            <input asp-for="SourceOfFunds" class="form-control" placeholder="Employment..." />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium">Notes</label>
                            <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Internal notes..."></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-check-lg me-1"></i>Create Transaction
                </button>
                <a href="/dashboard/transactions" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
