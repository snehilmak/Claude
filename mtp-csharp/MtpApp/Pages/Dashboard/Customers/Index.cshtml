@page
@model MtpApp.Pages.Dashboard.Customers.IndexModel
@{
    ViewData["Title"] = "Customers";
    Layout = "_Layout";
}

<div class="d-flex">
    @await Html.PartialAsync("_DashboardLayout")

    <div class="main-content p-4 w-100">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold mb-0">Customers</h4>
            <a href="/dashboard/customers/new" class="btn btn-primary">
                <i class="bi bi-person-plus me-1"></i> Add Customer
            </a>
        </div>

        <!-- ── Search ────────────────────────────────────────────────────── -->
        <form method="get" class="mb-4 d-flex gap-2">
            <input type="search" name="q" asp-for="SearchQuery" class="form-control"
                   placeholder="Search by name or phone..." style="max-width:350px;" />
            <button type="submit" class="btn btn-secondary">Search</button>
            @if (!string.IsNullOrEmpty(Model.SearchQuery))
            {
                <a href="/dashboard/customers" class="btn btn-outline-secondary">Clear</a>
            }
        </form>

        <!-- ── Customer table ────────────────────────────────────────────── -->
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Phone</th>
                            <th>ID Type</th>
                            <th>Country</th>
                            <th>CTR Flag</th>
                            <th>Status</th>
                            <th>Added</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Customers.Any())
                        {
                            <tr><td colspan="7" class="text-center text-muted py-5">No customers found</td></tr>
                        }
                        @foreach (var c in Model.Customers)
                        {
                            <tr>
                                <td class="fw-medium">@c.FullName</td>
                                <td class="font-monospace small">@c.Phone</td>
                                <td class="small text-muted">@(c.IdType?.ToString() ?? "—")</td>
                                <td class="small">@c.Country</td>
                                <td>
                                    @if (c.CtrFlag)
                                    {
                                        <span class="badge bg-warning text-dark">CTR</span>
                                    }
                                </td>
                                <td>
                                    @if (c.IsBlocked)
                                    {
                                        <span class="badge bg-danger">Blocked</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                </td>
                                <td class="text-muted small">@c.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
