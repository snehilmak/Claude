@page
@model RegisterModel
@{
    ViewData["Title"] = "Create Account";
    Layout = "_Layout";
}

<div class="d-flex align-items-center justify-content-center min-vh-100 bg-light">
    <div class="card shadow border-0 p-4" style="width:100%;max-width:460px;">
        <div class="text-center mb-4">
            <div class="bg-primary text-white rounded p-2 d-inline-block mb-2">
                <i class="bi bi-building fs-4"></i>
            </div>
            <h3 class="fw-bold mb-0">Create your account</h3>
            <p class="text-muted small">14-day free trial · No credit card required</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger py-2 small">@Model.ErrorMessage</div>
        }

        <form method="post">
            <div class="mb-3">
                <label class="form-label fw-medium">Agency / Business Name</label>
                <input asp-for="OrgName" type="text" class="form-control" placeholder="Acme Money Transfers" required />
            </div>
            <div class="mb-3">
                <label class="form-label fw-medium">Your Name</label>
                <input asp-for="UserName" type="text" class="form-control" placeholder="Jane Smith" required />
            </div>
            <div class="mb-3">
                <label class="form-label fw-medium">Email</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="you@example.com" required />
            </div>
            <div class="mb-4">
                <label class="form-label fw-medium">Password <small class="text-muted">(min 8 characters)</small></label>
                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" minlength="8" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">Create account</button>
        </form>

        <p class="text-center text-muted small mt-3">
            Already have an account? <a href="/login" class="text-primary">Sign in</a>
        </p>
    </div>
</div>
