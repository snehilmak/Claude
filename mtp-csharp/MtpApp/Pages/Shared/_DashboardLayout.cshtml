@* Partial view: dashboard sidebar + nav — included by all dashboard pages *@
@inject IHttpContextAccessor HttpContextAccessor

@{
    var path = HttpContextAccessor.HttpContext?.Request.Path.Value ?? "";
    // Helper to mark the active nav link
    Func<string, string> isActive = (p) => path.StartsWith(p) ? "active px-3 py-2 d-block" : "px-3 py-2 d-block";
}

<div class="d-flex">
    <!-- ── Sidebar ─────────────────────────────────────────────────────────── -->
    <nav class="sidebar d-flex flex-column p-3 gap-1" style="position:sticky;top:0;height:100vh;">
        <!-- Brand -->
        <div class="brand d-flex align-items-center gap-2 mb-4 px-2">
            <i class="bi bi-building fs-5 text-primary"></i>
            TransferPro
        </div>

        <a href="/dashboard" class="@isActive("/dashboard/index") @isActive("/dashboard")">
            <i class="bi bi-speedometer2 me-2"></i>Dashboard
        </a>
        <a href="/dashboard/transactions" class="@isActive("/dashboard/transactions")">
            <i class="bi bi-arrow-left-right me-2"></i>Transactions
        </a>
        <a href="/dashboard/customers" class="@isActive("/dashboard/customers")">
            <i class="bi bi-people me-2"></i>Customers
        </a>
        <a href="/dashboard/reports" class="@isActive("/dashboard/reports")">
            <i class="bi bi-file-earmark-bar-graph me-2"></i>Reports
        </a>

        <hr class="border-secondary my-2" />

        <a href="/dashboard/settings" class="@isActive("/dashboard/settings")">
            <i class="bi bi-gear me-2"></i>Settings
        </a>

        <!-- Spacer pushes logout to bottom -->
        <div class="flex-grow-1"></div>

        <form method="post" action="/logout">
            <button type="submit" class="btn btn-sm btn-outline-secondary w-100 text-start text-secondary">
                <i class="bi bi-box-arrow-left me-2"></i>Sign out
            </button>
        </form>
    </nav>

    <!-- ── Main content area — page content renders here ─────────────────── -->
    <div class="main-content p-4 w-100">
        @RenderSection("DashboardContent", required: false)
    </div>
</div>
