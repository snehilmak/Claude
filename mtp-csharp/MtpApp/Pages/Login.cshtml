@page
@model LoginModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_Layout";
}

<div class="d-flex align-items-center justify-content-center min-vh-100 bg-light">
    <div class="card shadow border-0 p-4" style="width:100%;max-width:420px;">
        <div class="text-center mb-4">
            <div class="bg-primary text-white rounded p-2 d-inline-block mb-2">
                <i class="bi bi-building fs-4"></i>
            </div>
            <h3 class="fw-bold mb-0">Sign in to TransferPro</h3>
            <p class="text-muted small">Enter your credentials below</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger py-2 small">@Model.ErrorMessage</div>
        }

        <form method="post">
            <div class="mb-3">
                <label class="form-label fw-medium">Email</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="you@example.com" required />
            </div>
            <div class="mb-4">
                <label class="form-label fw-medium">Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">Sign in</button>
        </form>

        <p class="text-center text-muted small mt-3">
            Don't have an account? <a href="/register" class="text-primary">Get started</a>
        </p>
    </div>
</div>
