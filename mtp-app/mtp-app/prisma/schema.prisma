generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Subscription & Tenant Models ───────────────────────────────────────────

model Organization {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  email              String             @unique
  phone              String?
  address            String?
  city               String?
  state              String?
  zip                String?
  country            String             @default("US")
  stripeCustomerId   String?            @unique
  subscriptionId     String?            @unique
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  locations      Location[]
  users          User[]
  customers      Customer[]
  transactions   Transaction[]
  companyConfigs CompanyConfig[]
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
}

model Location {
  id             String       @id @default(cuid())
  name           String
  address        String?
  city           String?
  state          String?
  zip            String?
  phone          String?
  licenseNumber  String? // MSB license
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  users        User[]
  transactions Transaction[]
}

// ─── User / Auth ─────────────────────────────────────────────────────────────

model User {
  id             String       @id @default(cuid())
  name           String
  email          String       @unique
  passwordHash   String
  role           UserRole     @default(AGENT)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId     String?
  location       Location?    @relation(fields: [locationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  transactions Transaction[]
  sessions     Session[]
}

enum UserRole {
  OWNER
  MANAGER
  AGENT
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── Customer (Sender) ────────────────────────────────────────────────────────

model Customer {
  id         String    @id @default(cuid())
  firstName  String
  lastName   String
  middleName String?
  dateOfBirth DateTime?
  email      String?
  phone      String
  address    String?
  city       String?
  state      String?
  zip        String?
  country    String    @default("US")

  // ID Verification
  idType     IdType?
  idNumber   String?
  idIssuedBy String?
  idExpiresAt DateTime?

  // Compliance flags
  isBlocked     Boolean @default(false)
  blockedReason String?
  ctrFlag       Boolean @default(false) // currency transaction report flag

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  transactions Transaction[]
}

enum IdType {
  PASSPORT
  DRIVERS_LICENSE
  STATE_ID
  MATRICULA
  OTHER
}

// ─── Money Transfer Companies ─────────────────────────────────────────────────

model TransferCompany {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique // e.g. "INTERMEX", "RIA", "VIGO"
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  transactions Transaction[]
  configs      CompanyConfig[]
}

// Per-org credentials / account config for each company
model CompanyConfig {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        TransferCompany @relation(fields: [companyId], references: [id])
  agentCode      String?
  accountNumber  String?
  apiKey         String?
  notes          String?
  isEnabled      Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, companyId])
}

// ─── Transactions ─────────────────────────────────────────────────────────────

model Transaction {
  id              String @id @default(cuid())
  referenceNumber String? // company's confirmation #
  controlNumber   String? // folio / pin

  // Parties
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id])
  recipientName    String
  recipientPhone   String?
  recipientAddress String?
  recipientCity    String?
  recipientCountry String

  // Amounts
  sendAmount      Decimal @db.Decimal(12, 2)
  sendCurrency    String  @default("USD")
  receiveAmount   Decimal @db.Decimal(12, 2)
  receiveCurrency String
  exchangeRate    Decimal @db.Decimal(10, 6)
  fee             Decimal @db.Decimal(10, 2)
  totalCollected  Decimal @db.Decimal(12, 2)

  // Company
  companyId String
  company   TransferCompany @relation(fields: [companyId], references: [id])

  // Payment method
  paymentMethod PaymentMethod @default(CASH)

  // Status
  status       TransactionStatus @default(PENDING)
  cancelReason String?

  // Compliance
  purposeOfTransfer String?
  sourceOfFunds     String?
  isCtrReported     Boolean @default(false)
  isSarFiled        Boolean @default(false)
  notes             String?

  // Relations
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  locationId     String
  location       Location     @relation(fields: [locationId], references: [id])
  agentId        String
  agent          User         @relation(fields: [agentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([customerId])
  @@index([status])
}

enum TransactionStatus {
  PENDING
  SENT
  PAID
  CANCELLED
  HELD
}

enum PaymentMethod {
  CASH
  DEBIT
  CHECK
}
